<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EducaGo.Mobile.Pages.HomePage"
             Title="HomePage">
    <StackLayout Padding="20">
        <Label Text="Inicio" FontSize="Large" FontAttributes="Bold" />

        <!-- Curso 1 -->
        <Frame BackgroundColor="#42A5F5" CornerRadius="10" Padding="10" Margin="5">
            <StackLayout>
                <Label Text="Curso 1" FontSize="Medium" TextColor="White" FontAttributes="Bold"/>
                <Label Text="75% por completar" FontSize="Small" TextColor="White"/>
                <ProgressBar Progress="0.75" BackgroundColor="White" HeightRequest="5"/>
            </StackLayout>
        </Frame>

        <!-- Curso 2 -->
        <Frame BackgroundColor="#FFA726" CornerRadius="10" Padding="10" Margin="5">
            <StackLayout>
                <Label Text="Curso 2" FontSize="Medium" TextColor="Black" FontAttributes="Bold"/>
                <Label Text="75% por completar" FontSize="Small" TextColor="Black"/>
                <ProgressBar Progress="0.75" BackgroundColor="White" HeightRequest="5"/>
            </StackLayout>
        </Frame>

        <!-- Curso 3 -->
        <Frame BackgroundColor="#EF9A9A" CornerRadius="10" Padding="10" Margin="5">
            <StackLayout>
                <Label Text="Curso 3" FontSize="Medium" TextColor="Black" FontAttributes="Bold"/>
                <Label Text="75% por completar" FontSize="Small" TextColor="Black"/>
                <ProgressBar Progress="0.75" BackgroundColor="White" HeightRequest="5"/>
            </StackLayout>
        </Frame>

        <!-- Curso 4 -->
        <Frame BackgroundColor="#90CAF9" CornerRadius="10" Padding="10" Margin="5">
            <StackLayout>
                <Label Text="Curso 3" FontSize="Medium" TextColor="Black" FontAttributes="Bold"/>
                <Label Text="75% por completar" FontSize="Small" TextColor="Black"/>
                <ProgressBar Progress="0.75" BackgroundColor="White" HeightRequest="5"/>
            </StackLayout>
        </Frame>

    </StackLayout>
</ContentPage>